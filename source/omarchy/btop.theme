# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#282A36"

# Main text color
theme[main_fg]="#F8F8F2"

# Title color for boxes
theme[title]="#F8F8F2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#BD93F9"

# Background color of selected item in processes box
theme[selected_bg]="#44475A"

# Foreground color of selected item in processes box
theme[selected_fg]="#BD93F9"

# Color of inactive/disabled text
theme[inactive_fg]="#6272A4"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#F8F8F2"

# Background color of the percentage meters
theme[meter_bg]="#44475A"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#F8F8F2"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#FF79C6"
theme[mem_box]="#50FA7B"
theme[net_box]="#FF5555"
theme[proc_box]="#BD93F9"

# Box divider line and small boxes line color
theme[div_line]="#6272A4"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#50FA7B"
theme[temp_mid]="#F1FA8C"
theme[temp_end]="#FF5555"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#8BE9FD"
theme[cpu_mid]="#BD93F9"
theme[cpu_end]="#FF79C6"

# Mem/Disk free meter
theme[free_start]="#FF79C6"
theme[free_mid]="#BD93F9"
theme[free_end]="#8BE9FD"

# Mem/Disk cached meter
theme[cached_start]="#BD93F9"
theme[cached_mid]="#8BE9FD"
theme[cached_end]="#FF79C6"

# Mem/Disk available meter
theme[available_start]="#F1FA8C"
theme[available_mid]="#FF5555"
theme[available_end]="#FF5555"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#50FA7B"
theme[used_mid]="#8BE9FD"
theme[used_end]="#BD93F9"

# Download graph colors
theme[download_start]="#F1FA8C"
theme[download_mid]="#FF5555"
theme[download_end]="#FF5555"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#50FA7B"
theme[upload_mid]="#8BE9FD"
theme[upload_end]="#BD93F9"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#8BE9FD"
theme[process_mid]="#BD93F9"
theme[process_end]="#FF79C6"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#282A36"
theme[gradient_color_1]="#343746"
theme[gradient_color_2]="#44475A"
theme[gradient_color_3]="#6272A4"
theme[gradient_color_4]="#6272A4"
theme[gradient_color_5]="#F8F8F2"
theme[gradient_color_6]="#F8F8F2"
theme[gradient_color_7]="#FFFFFF"
