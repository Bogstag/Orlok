{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "orlok",
  "version": "0.0.1",
  "description": "Orlok Dark Theme based on Dracula Theme",
  "keywords": [
    "dark theme",
    "dracula",
    "omarchy"
  ],
  "license": "MIT",
  "author": "Bogstag",
  "type": "module",
  "scripts": {
    "pin:engines": "mise use --pin node@latest npm@latest",
    "test": "echo \"Error: no test specified\" && exit 1",
    "theme:build-all": "node utils/swapper.js colors.toml theme.yaml && node utils/swapper.js colors.toml another-theme.yaml"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "npm run lint"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12"
    },
    "runtime": {
      "name": "node",
      "version": "26"
    }
  },
  "engines": {
    "node": "26",
    "npm": "12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
