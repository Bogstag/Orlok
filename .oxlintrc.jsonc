{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "pedantic": "warn",
    "perf": "warn",
    "restriction": "warn",
    "style": "warn",
    "suspicious": "warn"
  },
  "env": { "builtin": true, "esnext": true },
  "extends": ["/home/bogge/.oxlintrc.jsonc"],
  "ignorePatterns": [
    "*.min.js",
    "coverage/**",
    "dist/**",
    "test/snapshots/**",
    "vendor/**"
  ],
  "options": {
    "reportUnusedDisableDirectives": "error",
    "typeAware": true,
    "typeCheck": true
  },
  "overrides": [
    { "files": ["**/*.test.mjs", "cli/*.ts", "utils/*.ts"] }
  ],
  "plugins": [
    "eslint",
    "import",
    "jsdoc",
    "node",
    "oxc",
    "typescript",
    "unicorn",
    "vitest"
  ],
  "rules": {
    "eslint/func-style": ["error", "declaration"],
    "eslint/no-console": ["warn", { "allow": ["info", "error"] }],
    "eslint/sort-imports": [
      "allow",
      { "allowSeparatedGroups": true }
    ],
    "import/no-nodejs-modules": [
      "error",
      {
        "allow": [
          "node:path",
          "node:fs",
          "node:os",
          "node:fs/promises"
        ]
      }
    ],
    "import/no-nodejs-modules": [
      "error",
      {
        "allow": [
          "node:assert/strict",
          "node:child_process",
          "node:fs",
          "node:fs/promises",
          "node:os",
          "node:path",
          "node:test"
        ]
      }
    ],
    "node/no-top-level-await": "allow",
    "oxc/no-async-await": "allow",
    "sort-imports": "allow",
    "sort-keys": [
      "error",
      "asc",
      { "caseSensitive": true, "minKeys": 2, "natural": false }
    ],
    "sort-vars": "error",
    "typescript/prefer-readonly-parameter-types": "allow"
  }
}
